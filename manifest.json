{
  "manifest_version": 3,
  "name": "LILO Tools",
  "description": "Advanced developer toolbox: DNS lookup, image hosting with history, local notes, and secure password generator.",
  "version": "1.1.8",
  "homepage_url": "https://github.com/ISWAPPP/LILO",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://dns.google/*",
    "https://1.1.1.1/*",
    "https://freeimage.host/*",
    "https://ipwho.is/*",
    "https://ipinfo.io/*",
    "https://api.cert.ist/*"
  ],
  "optional_host_permissions": [
    "http://ip-api.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open LILO Tools"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}